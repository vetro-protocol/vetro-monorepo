{
  "extends": ["bloq", "prettier"],
  "ignorePatterns": [
    "**/_esm/**/*",
    "**/_types/**/*",
    "api/.wrangler/**/*",
    "internal-dashboard/dist/**/*",
    "subgraphs/*/.envio/**/*",
    "subgraphs/*/envio-env.d.ts",
    "subgraphs/*/generated/**/*",
    "web/dist/**/*",
    "web/playwright-report/**/*",
    "web/storybook-static/**/*",
    "web/test-results/**/*"
  ],
  "overrides": [
    {
      "excludedFiles": ["internal-dashboard/dist/**/*", "web/dist/**/*"],
      "extends": ["bloq/esm", "bloq/typescript", "prettier"],
      "files": [
        "*.{js,mjs}",
        "api/**/*.ts",
        "internal-dashboard/**/*.{js,ts,tsx}",
        "packages/**/*.{js,ts,tsx}",
        "subgraphs/**/*.ts",
        "web/**/*.{js,ts,tsx}"
      ],
      "rules": {
        "@typescript-eslint/array-type": ["error", { "default": "array" }],
        "@typescript-eslint/consistent-type-definitions": ["error", "type"],
        "@typescript-eslint/member-ordering": [
          "error",
          {
            "default": "never",
            "interfaces": {
              "memberTypes": "never",
              "order": "natural-case-insensitive"
            },
            "typeLiterals": {
              "memberTypes": "never",
              "order": "natural-case-insensitive"
            }
          }
        ]
      }
    },
    {
      "extends": ["bloq/react"],
      "files": ["internal-dashboard/**/*.{js,ts,tsx}"],
      "rules": {
        "react/jsx-sort-props": ["warn", { "ignoreCase": true }]
      }
    },
    {
      "excludedFiles": ["web/e2e/**"],
      "extends": ["bloq/react"],
      "files": ["web/**/*.{js,ts,tsx}"],
      "rules": {
        "react/jsx-sort-props": ["warn", { "ignoreCase": true }]
      }
    },
    {
      "files": ["web/test/**"],
      "rules": {
        "jsx-a11y/anchor-is-valid": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-static-element-interactions": "off"
      }
    },
    {
      "files": ["internal-dashboard/**/*.{js,ts,tsx}"],
      "plugins": ["better-tailwindcss"],
      "rules": {
        "better-tailwindcss/enforce-shorthand-classes": "error",
        "better-tailwindcss/no-concatenated-classes": "error",
        "better-tailwindcss/no-conflicting-classes": "error",
        "better-tailwindcss/no-unknown-classes": "error",
        "no-restricted-syntax": [
          "error",
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "FunctionDeclaration[params.length>=3]"
          },
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "VariableDeclarator > ArrowFunctionExpression[params.length>=3]"
          },
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "VariableDeclarator > FunctionExpression[params.length>=3]"
          },
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "VariableDeclarator > ArrowFunctionExpression > ArrowFunctionExpression[params.length>=3]"
          },
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "CallExpression[callee.name='useCallback'] > :function[params.length>=3]"
          },
          {
            "message": "Name maps of Tailwind classes *Class, *Classes or *ClassName so better-tailwindcss lints them.",
            "selector": "JSXAttribute[name.name=/^(class|className)$/] MemberExpression[computed=true] > Identifier.object:not([name=/(Class|Classes|ClassName)$/])"
          }
        ]
      },
      "settings": {
        "better-tailwindcss": {
          "cwd": "internal-dashboard",
          "entryPoint": "src/index.css",
          "selectors": {
            "extends": [
              {
                "kind": "variable",
                "match": [{ "type": "strings" }, { "type": "objectValues" }],
                "name": "^[a-zA-Z]*(?:Class|Classes|ClassName)$"
              },
              { "kind": "attribute", "name": "^[a-zA-Z]*ClassName$" }
            ]
          }
        }
      }
    },
    {
      "files": ["web/**/*.{js,ts,tsx}"],
      "plugins": ["better-tailwindcss"],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "message": "Name maps of Tailwind classes *Class, *Classes or *ClassName so better-tailwindcss lints them.",
            "selector": "JSXAttribute[name.name=/^(class|className)$/] MemberExpression[computed=true] > Identifier.object:not([name=/(Class|Classes|ClassName)$/])"
          }
        ],
        "better-tailwindcss/enforce-shorthand-classes": "error",
        "better-tailwindcss/no-concatenated-classes": "error",
        "better-tailwindcss/no-conflicting-classes": "error",
        "better-tailwindcss/no-unknown-classes": [
          "error",
          {
            "ignore": [
              "^button-",
              "^button--base$",
              "^input--base$",
              "^textarea--base$",
              "^vetro-tooltip-"
            ]
          }
        ]
      },
      "settings": {
        "better-tailwindcss": {
          "cwd": "web",
          "entryPoint": "src/index.css",
          "selectors": {
            "extends": [
              {
                "kind": "variable",
                "match": [{ "type": "strings" }, { "type": "objectValues" }],
                "name": "^[a-zA-Z]*(?:Class|Classes|ClassName)$"
              },
              { "kind": "attribute", "name": "^[a-zA-Z]*ClassName$" }
            ]
          }
        }
      }
    },
    {
      "extends": ["bloq/markdown"],
      "files": ["*.md"],
      "rules": {
        "markdownlint/md024": "off"
      }
    },
    {
      "extends": ["bloq/markdown"],
      "files": [".github/pull_request_template.md"],
      "rules": {
        "markdownlint/md041": "off"
      }
    },
    {
      "extends": ["bloq/typescript", "prettier"],
      "files": ["*.d.ts"],
      "rules": {
        "@typescript-eslint/consistent-type-definitions": "off"
      }
    },
    {
      "extends": ["bloq/typescript", "bloq/vitest"],
      "files": ["*.{spec,test}.{js,ts,tsx}"]
    },
    {
      "files": ["web/stories/**/*.{js,ts,tsx}"],
      "rules": {
        "no-alert": "off"
      }
    },
    {
      "files": ["web/e2e/**/*.ts"],
      "rules": {
        "@vitest/require-hook": "off"
      }
    },
    {
      "files": ["subgraphs/*/tests/**/*.ts"],
      "rules": {
        "@vitest/require-hook": "off"
      }
    },
    {
      "files": ["packages/**/*.{js,ts,tsx}"],
      "rules": {
        "complexity": ["warn", { "max": 20 }],
        "no-restricted-syntax": [
          "error",
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "FunctionDeclaration[params.length>=3]"
          },
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "VariableDeclarator > ArrowFunctionExpression[params.length>=3]"
          },
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "VariableDeclarator > FunctionExpression[params.length>=3]"
          },
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "VariableDeclarator > ArrowFunctionExpression > ArrowFunctionExpression[params.length>=3]"
          },
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "CallExpression[callee.name='useCallback'] > :function[params.length>=3]"
          }
        ]
      }
    },
    {
      "files": ["api/**/*.ts", "web/scripts/**/*.ts"],
      "rules": {
        "no-console": "off",
        "no-restricted-syntax": [
          "error",
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "FunctionDeclaration[params.length>=3]"
          },
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "VariableDeclarator > ArrowFunctionExpression[params.length>=3]"
          },
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "VariableDeclarator > FunctionExpression[params.length>=3]"
          },
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "VariableDeclarator > ArrowFunctionExpression > ArrowFunctionExpression[params.length>=3]"
          },
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "CallExpression[callee.name='useCallback'] > :function[params.length>=3]"
          }
        ]
      }
    },
    {
      "excludedFiles": ["web/src/utils/lazyWithReload.ts"],
      "files": ["web/src/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "importNames": ["lazy"],
                "message": "Use lazyWithReload from utils/lazyWithReload, so a chunk that fails to load after a deploy reloads the page.",
                "name": "react"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["api/src/contact.ts", "api/src/param-validators.ts"],
      "rules": {
        "@typescript-eslint/consistent-type-definitions": "off"
      }
    },
    {
      "excludedFiles": ["web/src/utils/date.ts", "web/src/utils/format.ts"],
      "files": ["web/src/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "FunctionDeclaration[params.length>=3]"
          },
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "VariableDeclarator > ArrowFunctionExpression[params.length>=3]"
          },
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "VariableDeclarator > FunctionExpression[params.length>=3]"
          },
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "VariableDeclarator > ArrowFunctionExpression > ArrowFunctionExpression[params.length>=3]"
          },
          {
            "message": "Use an object parameter for functions that take 3 or more parameters.",
            "selector": "CallExpression[callee.name='useCallback'] > :function[params.length>=3]"
          },
          {
            "message": "Use a formatting helper from utils/format or utils/date instead.",
            "selector": "MemberExpression[object.name='Intl'][property.name=/Format$/]"
          },
          {
            "message": "Use a formatting helper from utils/format or utils/date instead.",
            "selector": "MemberExpression[computed=true][object.name='Intl'][property.value=/Format$/]"
          },
          {
            "message": "Use a formatting helper from utils/format or utils/date instead.",
            "selector": "MemberExpression[property.name=/^toLocale.*String$/]"
          },
          {
            "message": "Use a formatting helper from utils/format or utils/date instead.",
            "selector": "MemberExpression[computed=true][property.value=/^toLocale.*String$/]"
          },
          {
            "message": "Name maps of Tailwind classes *Class, *Classes or *ClassName so better-tailwindcss lints them.",
            "selector": "JSXAttribute[name.name=/^(class|className)$/] MemberExpression[computed=true] > Identifier.object:not([name=/(Class|Classes|ClassName)$/])"
          },
          {
            "message": "Do not take queryClient as a parameter of a queryOptions factory. Read it in the queryFn: queryFn: ({ client: queryClient }) => ...",
            "selector": ":function:has(Identifier[name='queryClient'][typeAnnotation], ObjectPattern > Property[key.name='queryClient'], TSPropertySignature[key.name='queryClient']) CallExpression[callee.name='queryOptions']"
          }
        ]
      }
    }
  ],
  "root": true
}
